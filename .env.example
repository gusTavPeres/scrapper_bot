# Copie para .env (o ./setup.sh faz isso e gera a senha do painel).

# Telegram (opcional, mas é por onde chegam os alertas). Crie o bot com o @BotFather
# e cole o token. Sem o CHAT_ID, mande qualquer mensagem ao bot: ele responde com o seu.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Painel web (HTTP Basic). Sem BOT_PASS o programa não sobe.
BOT_USER=admin
BOT_PASS=

# Onde o painel escuta (0.0.0.0 = acessível na rede local; 127.0.0.1 = só nesta máquina)
HOST=0.0.0.0
PORT=8080
